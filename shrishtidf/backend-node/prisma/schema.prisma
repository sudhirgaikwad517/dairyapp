generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cart {
  id        String     @id
  sessionId String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime
  CartItem  CartItem[]
}

model CartItem {
  id           String       @id
  cartId       String
  productId    String
  quantity     Int          @default(1)
  purchaseType PurchaseType @default(BUY_ONCE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  Cart         Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, purchaseType])
  @@index([cartId])
}

model Order {
  id           String      @id
  sessionId    String?
  customerName String?
  phone        String?
  address      String?
  status       OrderStatus @default(PENDING)
  totalAmount  Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  OrderItem    OrderItem[]

  @@index([sessionId])
}

model OrderItem {
  id           String       @id
  orderId      String
  productId    String
  productName  String
  size         String
  quantity     Int
  unitPrice    Int
  purchaseType PurchaseType
  lineTotal    Int
  Order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Product {
  id              String          @id
  categoryId      String
  name            String
  size            String
  buyOnce         Int
  subscription    Int
  badge           String?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  videoPoster     String?
  videoUrl        String?
  CartItem        CartItem[]
  ProductCategory ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model ProductCategory {
  id               String    @id
  label            String
  tile             String
  subscriptionNote String    @default("30 days subscription")
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  Product          Product[]
}

model blog_posts {
  id           String    @id @db.Uuid
  slug         String    @unique(map: "blog_posts_slug_unique") @db.VarChar(255)
  title        String    @db.VarChar(255)
  excerpt      String?
  body         String?
  published_at DateTime? @db.Timestamp(0)
  is_published Boolean   @default(false)
  sort_order   Int       @default(0)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  @@index([is_published, published_at], map: "blog_posts_is_published_published_at_index")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model cart_items {
  id               String            @id @db.Uuid
  cart_id          String            @db.Uuid
  product_id       String            @db.VarChar(255)
  quantity         Int               @default(1)
  purchase_type    String            @default("BUY_ONCE") @db.VarChar(255)
  created_at       DateTime?         @db.Timestamp(0)
  updated_at       DateTime?         @db.Timestamp(0)
  variant_id       String?           @db.Uuid
  carts            carts             @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_cart_id_foreign")
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_product_id_foreign")
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction, map: "cart_items_variant_id_foreign")

  @@unique([cart_id, product_id, variant_id, purchase_type], map: "cart_items_line_unique")
  @@index([cart_id], map: "cart_items_cart_id_index")
}

model carts {
  id         String       @id @db.Uuid
  session_id String       @unique(map: "carts_session_id_unique") @db.VarChar(255)
  created_at DateTime?    @db.Timestamp(0)
  updated_at DateTime?    @db.Timestamp(0)
  cart_items cart_items[]
}

model customer_wallets {
  id          String    @id @db.Uuid
  customer_id String    @unique(map: "customer_wallets_customer_id_unique") @db.Uuid
  balance     BigInt    @default(0)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_wallets_customer_id_foreign")
}

model customers {
  id                                                  String                @id @db.Uuid
  phone                                               String                @unique(map: "customers_phone_unique") @db.VarChar(255)
  name                                                String?               @db.VarChar(255)
  address                                             String?
  orders_count                                        Int                   @default(0)
  leads_count                                         Int                   @default(0)
  last_seen_at                                        DateTime?             @db.Timestamp(0)
  notes                                               String?
  created_at                                          DateTime?             @db.Timestamp(0)
  updated_at                                          DateTime?             @db.Timestamp(0)
  email                                               String?               @db.VarChar(255)
  flat_no                                             String?               @db.VarChar(255)
  society_name                                        String?               @db.VarChar(255)
  street_name                                         String?               @db.VarChar(255)
  landmark                                            String?               @db.VarChar(255)
  city                                                String?               @db.VarChar(255)
  state                                               String?               @db.VarChar(255)
  pincode                                             String?               @db.VarChar(10)
  loyalty_points                                      Int                   @default(0)
  is_active                                            Boolean               @default(true)
  referral_code                                       String?               @unique(map: "customers_referral_code_unique") @db.VarChar(12)
  code                                                 String?               @unique(map: "customers_code_unique") @db.VarChar(20)
  alternate_phone                                      String?               @db.VarChar(20)
  date_of_birth                                        DateTime?             @db.Date
  residence_type                                       String?               @db.VarChar(50)
  area                                                 String?               @db.VarChar(255)
  delivery_mode                                        String                @default("Ring the Bell") @db.VarChar(50)
  customer_type                                        String                @default("prepaid") @db.VarChar(20)
  registered_by                                        String                @default("customer") @db.VarChar(20)
  hub_id                                               String?               @db.Uuid
  route_id                                             String?               @db.Uuid
  delivery_boy_id                                      String?               @db.Uuid
  delivery_sequence                                    Int                   @default(0)
  latitude                                             Decimal?              @db.Decimal(10, 7)
  longitude                                            Decimal?              @db.Decimal(10, 7)
  hubs                                                 hubs?                 @relation(fields: [hub_id], references: [id], onUpdate: NoAction, map: "customers_hub_id_foreign")
  delivery_routes                                      delivery_routes?      @relation(fields: [route_id], references: [id], onUpdate: NoAction, map: "customers_route_id_foreign")
  delivery_boys                                        delivery_boys?        @relation(fields: [delivery_boy_id], references: [id], onUpdate: NoAction, map: "customers_delivery_boy_id_foreign")
  customer_wallets                                    customer_wallets?
  activity_logs                                       activity_logs[]
  customer_feedback                                   customer_feedback[]
  customer_delivery_boy_changes                       customer_delivery_boy_changes[]
  delivery_records                                    delivery_records[]
  orders                                              orders[]
  referrals_referrals_referred_customer_idTocustomers referrals[]           @relation("referrals_referred_customer_idTocustomers")
  referrals_referrals_referrer_customer_idTocustomers referrals[]           @relation("referrals_referrer_customer_idTocustomers")
  subscriptions                                       subscriptions[]
  wallet_transactions                                 wallet_transactions[]

  @@index([city], map: "customers_city_index")
  @@index([email], map: "customers_email_index")
  @@index([pincode], map: "customers_pincode_index")
}

model hubs {
  id              String            @id @db.Uuid
  name            String            @db.VarChar(255)
  city            String?           @db.VarChar(255)
  is_active       Boolean           @default(true)
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  customers       customers[]
  delivery_routes delivery_routes[]
  delivery_boys   delivery_boys[]
}

model customer_delivery_boy_changes {
  id                    String         @id @db.Uuid
  customer_id           String         @db.Uuid
  old_delivery_boy_id   String?        @db.Uuid
  new_delivery_boy_id   String?        @db.Uuid
  narration             String?
  changed_by            String?        @db.VarChar(255)
  changed_at            DateTime       @default(now())
  customers             customers      @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_delivery_boy_changes_customer_id_foreign")

  @@index([customer_id], map: "customer_delivery_boy_changes_customer_id_index")
}

model delivery_routes {
  id             String           @id @db.Uuid
  name           String           @db.VarChar(255)
  route_code     String           @unique(map: "delivery_routes_route_code_unique") @db.VarChar(255)
  dispatch_time  DateTime         @default(dbgenerated("'05:00:00'::time without time zone")) @db.Time(0)
  city           String?          @db.VarChar(255)
  driver_id      String?          @db.Uuid
  hub_id         String?          @db.Uuid
  sort_order     Int              @default(0)
  is_active      Boolean          @default(true)
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  delivery_boys  delivery_boys?   @relation(fields: [driver_id], references: [id], onUpdate: NoAction, map: "delivery_routes_driver_id_foreign")
  hubs           hubs?            @relation(fields: [hub_id], references: [id], onUpdate: NoAction, map: "delivery_routes_hub_id_foreign")
  delivery_slots delivery_slots[]
  delivery_zones delivery_zones[]
  delivery_areas delivery_areas[]
  orders         orders[]
  customers      customers[]

  @@index([hub_id], map: "delivery_routes_hub_id_index")
}

model delivery_boys {
  id                String            @id @db.Uuid
  name              String            @db.VarChar(255)
  first_name        String?           @db.VarChar(255)
  middle_name       String?           @db.VarChar(255)
  last_name         String?           @db.VarChar(255)
  phone             String?           @db.VarChar(20)
  date_of_birth     DateTime?         @db.Date
  address           String?
  city              String?           @db.VarChar(255)
  hub_id            String?           @db.Uuid
  photo_url         String?           @db.VarChar(500)
  aadhar_url        String?           @db.VarChar(500)
  username          String?           @unique(map: "delivery_boys_username_unique") @db.VarChar(100)
  password          String?           @db.VarChar(255)
  is_active         Boolean           @default(true)
  created_at        DateTime?         @db.Timestamp(0)
  updated_at        DateTime?         @db.Timestamp(0)
  hubs              hubs?             @relation(fields: [hub_id], references: [id], onUpdate: NoAction, map: "delivery_boys_hub_id_foreign")
  delivery_routes   delivery_routes[]
  customers         customers[]
  delivery_records  delivery_records[]

  @@index([hub_id], map: "delivery_boys_hub_id_index")
}

model delivery_areas {
  id              String           @id @db.Uuid
  state           String?          @db.VarChar(255)
  city            String?          @db.VarChar(255)
  area_name       String           @db.VarChar(255)
  area_pin        String?          @db.VarChar(10)
  is_serviceable  Boolean          @default(true)
  route_id        String?          @db.Uuid
  created_at      DateTime?        @db.Timestamp(0)
  updated_at      DateTime?        @db.Timestamp(0)
  delivery_routes delivery_routes? @relation(fields: [route_id], references: [id], onUpdate: NoAction, map: "delivery_areas_route_id_foreign")
  sub_areas       sub_areas[]

  @@index([city], map: "delivery_areas_city_index")
  @@index([route_id], map: "delivery_areas_route_id_index")
}

model sub_areas {
  id               String         @id @db.Uuid
  delivery_area_id String         @db.Uuid
  name             String         @db.VarChar(255)
  created_at       DateTime?      @db.Timestamp(0)
  updated_at       DateTime?      @db.Timestamp(0)
  delivery_areas   delivery_areas @relation(fields: [delivery_area_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sub_areas_delivery_area_id_foreign")
  apartments       apartments[]

  @@index([delivery_area_id], map: "sub_areas_delivery_area_id_index")
}

model apartments {
  id          String    @id @db.Uuid
  sub_area_id String    @db.Uuid
  name        String    @db.VarChar(255)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  sub_areas   sub_areas @relation(fields: [sub_area_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "apartments_sub_area_id_foreign")

  @@index([sub_area_id], map: "apartments_sub_area_id_index")
}

model delivery_records {
  id                 String            @id @db.Uuid
  subscription_id    String            @db.Uuid
  customer_id        String            @db.Uuid
  delivery_boy_id    String?           @db.Uuid
  delivery_date      DateTime          @db.Date
  product_id         String            @db.VarChar(255)
  variant_id         String?           @db.Uuid
  quantity_ordered   Decimal           @default(0) @db.Decimal(6, 2)
  quantity_delivered Decimal           @default(0) @db.Decimal(6, 2)
  pending_qty        Decimal           @default(0) @db.Decimal(6, 2)
  remark             String?           @db.VarChar(255)
  bottles_collected  Int               @default(0)
  status             String            @default("delivered") @db.VarChar(20)
  delivered_at       DateTime?         @db.Timestamp(0)
  created_at         DateTime?         @db.Timestamp(0)
  updated_at         DateTime?         @db.Timestamp(0)
  subscriptions      subscriptions     @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "delivery_records_subscription_id_foreign")
  customers          customers         @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "delivery_records_customer_id_foreign")
  delivery_boys      delivery_boys?    @relation(fields: [delivery_boy_id], references: [id], onUpdate: NoAction, map: "delivery_records_delivery_boy_id_foreign")
  products           products          @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "delivery_records_product_id_foreign")
  product_variants   product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction, map: "delivery_records_variant_id_foreign")

  @@unique([subscription_id, delivery_date], map: "delivery_records_subscription_date_unique")
  @@index([delivery_boy_id, delivery_date], map: "delivery_records_delivery_boy_id_delivery_date_index")
  @@index([delivery_date], map: "delivery_records_delivery_date_index")
  @@index([customer_id], map: "delivery_records_customer_id_index")
}

model delivery_slots {
  id              String           @id @db.Uuid
  label           String           @db.VarChar(255)
  start_time      DateTime         @db.Time(0)
  end_time        DateTime         @db.Time(0)
  route_id        String?          @db.Uuid
  sort_order      Int              @default(0)
  is_active       Boolean          @default(true)
  created_at      DateTime?        @db.Timestamp(0)
  updated_at      DateTime?        @db.Timestamp(0)
  delivery_routes delivery_routes? @relation(fields: [route_id], references: [id], onUpdate: NoAction, map: "delivery_slots_route_id_foreign")
  orders          orders[]
  subscriptions   subscriptions[]
}

model delivery_zones {
  id              String           @id @db.Uuid
  pincode         String           @unique(map: "delivery_zones_pincode_unique") @db.VarChar(10)
  city            String?          @db.VarChar(255)
  area_name       String?          @db.VarChar(255)
  delivery_fee    Int              @default(0)
  min_order_value Int?
  route_id        String?          @db.Uuid
  is_serviceable  Boolean          @default(true)
  created_at      DateTime?        @db.Timestamp(0)
  updated_at      DateTime?        @db.Timestamp(0)
  delivery_routes delivery_routes? @relation(fields: [route_id], references: [id], onUpdate: NoAction, map: "delivery_zones_route_id_foreign")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String
  queue      String
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model inventory_batches {
  id                 String            @id @db.Uuid
  product_id         String            @db.VarChar(255)
  variant_id         String?           @db.Uuid
  batch_number       String            @db.VarChar(255)
  manufacturing_date DateTime          @db.Date
  expiry_date        DateTime          @db.Date
  quantity           Int               @default(0)
  storage_type       String            @default("chilled") @db.VarChar(255)
  notes              String?
  created_at         DateTime?         @db.Timestamp(0)
  updated_at         DateTime?         @db.Timestamp(0)
  products           products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inventory_batches_product_id_foreign")
  product_variants   product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction, map: "inventory_batches_variant_id_foreign")

  @@index([expiry_date, storage_type], map: "inventory_batches_expiry_date_storage_type_index")
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int    @db.SmallInt
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

model leads {
  id         String    @id @db.Uuid
  name       String    @db.VarChar(255)
  phone      String    @db.VarChar(255)
  source     String    @default("free_sample") @db.VarChar(255)
  status     String    @default("new") @db.VarChar(255)
  message    String?
  notes      String?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  @@index([created_at], map: "leads_created_at_index")
  @@index([phone], map: "leads_phone_index")
  @@index([status], map: "leads_status_index")
}

model manufacturing_units {
  id                   BigInt    @id @default(autoincrement())
  batch_code           String    @unique(map: "manufacturing_units_batch_code_unique") @db.VarChar(10)
  company_name         String    @db.VarChar(255)
  address              String
  fssai_licence_number String    @db.VarChar(255)
  sort_order           Int       @default(0)
  created_at           DateTime? @db.Timestamp(0)
  updated_at           DateTime? @db.Timestamp(0)
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model order_items {
  id               String            @id @db.Uuid
  order_id         String            @db.Uuid
  product_id       String            @db.VarChar(255)
  product_name     String            @db.VarChar(255)
  size             String            @db.VarChar(255)
  quantity         Int
  unit_price       Int
  purchase_type    String            @db.VarChar(255)
  line_total       Int
  created_at       DateTime?         @db.Timestamp(0)
  updated_at       DateTime?         @db.Timestamp(0)
  variant_id       String?           @db.Uuid
  batch_number     String?           @db.VarChar(255)
  gst_rate         Decimal           @default(0) @db.Decimal(5, 2)
  tax_amount       BigInt            @default(0)
  orders           orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_order_id_foreign")
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction, map: "order_items_variant_id_foreign")

  @@index([order_id], map: "order_items_order_id_index")
}

model orders {
  id                  String           @id @db.Uuid
  session_id          String?          @db.VarChar(255)
  customer_name       String?          @db.VarChar(255)
  phone               String?          @db.VarChar(255)
  address             String?
  status              String           @default("PENDING") @db.VarChar(255)
  total_amount        Int
  created_at          DateTime?        @db.Timestamp(0)
  updated_at          DateTime?        @db.Timestamp(0)
  razorpay_order_id   String?          @db.VarChar(255)
  razorpay_payment_id String?          @db.VarChar(255)
  payment_status      String           @default("pending") @db.VarChar(255)
  customer_id         String?          @db.Uuid
  pincode             String?          @db.VarChar(10)
  delivery_date       DateTime?        @db.Date
  delivery_slot_id    String?          @db.Uuid
  route_id            String?          @db.Uuid
  subtotal            BigInt           @default(0)
  tax_amount          BigInt           @default(0)
  delivery_fee        BigInt           @default(0)
  wallet_amount_used  BigInt           @default(0)
  payment_method      String           @default("cod") @db.VarChar(255)
  invoice_number      String?          @db.VarChar(255)
  order_items         order_items[]
  customers           customers?       @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "orders_customer_id_foreign")
  delivery_slots      delivery_slots?  @relation(fields: [delivery_slot_id], references: [id], onUpdate: NoAction, map: "orders_delivery_slot_id_foreign")
  delivery_routes     delivery_routes? @relation(fields: [route_id], references: [id], onUpdate: NoAction, map: "orders_route_id_foreign")

  @@index([session_id], map: "orders_session_id_index")
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model product_categories {
  id                String     @id @db.VarChar(255)
  label             String     @db.VarChar(255)
  tile              String     @db.VarChar(255)
  image_url         String?    @db.VarChar(255)
  description       String?
  is_active         Boolean    @default(true)
  subscription_note String     @default("30 days subscription") @db.VarChar(255)
  sort_order        Int        @default(0)
  created_at        DateTime?  @db.Timestamp(0)
  updated_at        DateTime?  @db.Timestamp(0)
  products          products[]
  product_sub_categories product_sub_categories[]
}

model product_sub_categories {
  id                  String              @id @db.VarChar(255)
  category_id         String              @db.VarChar(255)
  label               String              @db.VarChar(255)
  image_url           String?             @db.VarChar(500)
  is_active           Boolean             @default(true)
  sort_order          Int                 @default(0)
  created_at          DateTime?           @db.Timestamp(0)
  updated_at          DateTime?           @db.Timestamp(0)
  product_categories  product_categories  @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_sub_categories_category_id_foreign")
  products            products[]

  @@index([category_id], map: "product_sub_categories_category_id_index")
}

model product_images {
  id         String    @id @db.Uuid
  product_id String    @db.VarChar(255)
  image_url  String    @db.VarChar(500)
  sort_order Int       @default(0)
  created_at DateTime? @db.Timestamp(0)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_images_product_id_foreign")

  @@index([product_id], map: "product_images_product_id_index")
}

model product_cross_sells {
  id                                                        String    @id @db.Uuid
  product_id                                                String    @db.VarChar(255)
  related_product_id                                        String    @db.VarChar(255)
  sort_order                                                Int       @default(0)
  created_at                                                DateTime? @db.Timestamp(0)
  updated_at                                                DateTime? @db.Timestamp(0)
  products_product_cross_sells_product_idToproducts         products  @relation("product_cross_sells_product_idToproducts", fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_cross_sells_product_id_foreign")
  products_product_cross_sells_related_product_idToproducts products  @relation("product_cross_sells_related_product_idToproducts", fields: [related_product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_cross_sells_related_product_id_foreign")

