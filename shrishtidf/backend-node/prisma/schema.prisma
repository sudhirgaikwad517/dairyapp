  customers_referrals_referrer_customer_idTocustomers customers  @relation("referrals_referrer_customer_idTocustomers", fields: [referrer_customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "referrals_referrer_customer_id_foreign")
