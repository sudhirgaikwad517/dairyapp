model subscriptions {
  id                 String            @id @db.Uuid
  customer_id        String            @db.Uuid
  product_id         String            @db.VarChar(255)
  variant_id         String?           @db.Uuid
  frequency          String            @default("daily") @db.VarChar(255)
  quantity           Int               @default(1)
  delivery_slot_id   String?           @db.Uuid
  status             String            @default("active") @db.VarChar(255)
  next_delivery_date DateTime?         @db.Date
  paused_from        DateTime?         @db.Date
  paused_until       DateTime?         @db.Date
  wallet_auto_debit  Boolean           @default(false)
  cancel_reason_id   String?           @db.Uuid
  cancel_note        String?
  created_at         DateTime?         @db.Timestamp(0)
  updated_at         DateTime?         @db.Timestamp(0)
  customers          customers         @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "subscriptions_customer_id_foreign")
  delivery_slots     delivery_slots?   @relation(fields: [delivery_slot_id], references: [id], onUpdate: NoAction, map: "subscriptions_delivery_slot_id_foreign")
  products           products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "subscriptions_product_id_foreign")
  product_variants   product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction, map: "subscriptions_variant_id_foreign")
  cancel_reasons     cancel_reasons?   @relation(fields: [cancel_reason_id], references: [id], onUpdate: NoAction, map: "subscriptions_cancel_reason_id_foreign")
  delivery_records   delivery_records[]

  @@index([status, next_delivery_date], map: "subscriptions_status_next_delivery_date_index")
}

