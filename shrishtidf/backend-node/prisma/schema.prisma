model product_reviews {
  id            String    @id @db.Uuid
  product_id    String    @db.VarChar(255)
  customer_name String    @db.VarChar(255)
  rating        Int       @default(5) @db.SmallInt
  comment       String?
  is_published  Boolean   @default(true)
