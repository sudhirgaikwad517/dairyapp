  updated_at    DateTime? @db.Timestamp(0)
  products      products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_reviews_product_id_foreign")

  @@index([product_id, is_published], map: "product_reviews_product_id_is_published_index")
}

model product_variants {
  id                String              @id @db.Uuid
  product_id        String              @db.VarChar(255)
  sku               String              @unique(map: "product_variants_sku_unique") @db.VarChar(255)
  size_label        String              @db.VarChar(255)
  buy_once          Int
  subscription      Int
  weight_grams      Int?
  sort_order        Int                 @default(0)
  is_default        Boolean             @default(false)
  stock_quantity    Int                 @default(0)
  city              String?             @db.VarChar(255)
  packets           Int                 @default(1)
  ltrs              Decimal?            @db.Decimal(6, 2)
  mrp_ecom          Int                 @default(0)
  bottle_applicable Boolean             @default(false)
  pouch_applicable  Boolean             @default(false)
  out_of_stock      Boolean             @default(false)
  web_visibility    Boolean             @default(true)
  app_visibility    Boolean             @default(true)
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  cart_items        cart_items[]
  inventory_batches inventory_batches[]
  order_items       order_items[]
  products          products            @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_variants_product_id_foreign")
  subscriptions     subscriptions[]
  wastage_logs      wastage_logs[]
  delivery_records  delivery_records[]

  @@index([product_id, sort_order], map: "product_variants_product_id_sort_order_index")
}

model products {
  id                                                                   String                @id @db.VarChar(255)
  category_id                                                          String                @db.VarChar(255)
  name                                                                 String                @db.VarChar(255)
  size                                                                 String                @db.VarChar(255)
  buy_once                                                             Int
  subscription                                                         Int
  badge                                                                String?               @db.VarChar(255)
  video_url                                                            String?               @db.VarChar(255)
  video_poster                                                         String?               @db.VarChar(255)
  sort_order                                                           Int                   @default(0)
  created_at                                                           DateTime?             @db.Timestamp(0)
  updated_at                                                           DateTime?             @db.Timestamp(0)
  image_url                                                            String?               @db.VarChar(255)
  description                                                          String?
  specifications                                                       Json?                 @db.Json
  shelf_life_type                                                      String                @default("short") @db.VarChar(255)
  storage_type                                                         String                @default("chilled") @db.VarChar(255)
  gst_rate                                                             Decimal               @default(0) @db.Decimal(5, 2)
  is_tax_inclusive                                                     Boolean               @default(true)
  subscription_frequency                                               String?               @db.VarChar(255)
  allow_subscription                                                   Boolean               @default(true)
  stock_quantity                                                       Int                   @default(0)
  low_stock_threshold                                                  Int                   @default(5)
  is_active                                                            Boolean               @default(true)
  sub_category_id                                                      String?               @db.VarChar(255)
  product_type                                                         String?               @db.VarChar(100)
  short_code                                                           String?               @db.VarChar(50)
  discount                                                             Int                   @default(0)
  hsn_code                                                             String?               @db.VarChar(50)
  prepaid_getonce                                                      Boolean               @default(true)
  prepaid_subscribe                                                    Boolean               @default(true)
  postpaid_getonce                                                     Boolean               @default(true)
  postpaid_subscribe                                                   Boolean               @default(true)
  cart_items                                                           cart_items[]
  inventory_batches                                                    inventory_batches[]
  product_cross_sells_product_cross_sells_product_idToproducts         product_cross_sells[] @relation("product_cross_sells_product_idToproducts")
  product_cross_sells_product_cross_sells_related_product_idToproducts product_cross_sells[] @relation("product_cross_sells_related_product_idToproducts")
  product_images                                                       product_images[]
  product_reviews                                                      product_reviews[]
  product_variants                                                     product_variants[]
  product_categories                                                   product_categories    @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "products_category_id_foreign")
  product_sub_categories                                               product_sub_categories? @relation(fields: [sub_category_id], references: [id], onUpdate: NoAction, map: "products_sub_category_id_foreign")
  subscriptions                                                        subscriptions[]
  wastage_logs                                                         wastage_logs[]
  delivery_records                                                     delivery_records[]

  @@index([category_id], map: "products_category_id_index")
  @@index([sub_category_id], map: "products_sub_category_id_index")
}

