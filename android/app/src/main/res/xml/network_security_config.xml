<?xml version="1.0" encoding="utf-8"?>
<!--
  Production default: cleartext (plain http) traffic is blocked everywhere.
  The debug build type overrides this with a permissive config for local
  development — see src/debug/res/xml/network_security_config.xml — so this
  file only ever governs release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
