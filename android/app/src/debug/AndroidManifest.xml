<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay, merged on top of src/main/AndroidManifest.xml
  for debug builds only. Cleartext http is only ever needed talking to a
  local dev backend (LAN IP / adb reverse loopback) — real release builds
  must never allow it, which is why this isn't in the main manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
